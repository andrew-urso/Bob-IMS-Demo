CREATE PROGRAMVIEW DFSSAM04 (
    CREATE SCHEMA DBPCB01 USING DFSSAM04
        AS DBPCB01 (
            CREATE SENSEGVIEW PARTROOT,
            CREATE SENSEGVIEW STANINFO,
            CREATE SENSEGVIEW STOKSTAT
        )
        PROCOPT 'AP' LISTYES
        POSSNGL SBCOND
) CMPATYES GSROLBOKNO OLICYES LOCKMAX 0 IOASIZE 600 SSASIZE 840
    LANGASSEM;

COMMIT DDL;
